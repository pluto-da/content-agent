{
  "name": "@content-agent/shared",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "前后端共用的纯函数：提示词、平台规则、Schema 校验与修复、合规检查、RSS/热榜解析、模型错误白话化",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}