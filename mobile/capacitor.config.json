{
  "appId": "local.contentagent.app",
  "appName": "超级工作台",
  "webDir": "../web/dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DEFAULT"
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  }
}
