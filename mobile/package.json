{
  "name": "content-agent-mobile",
  "version": "0.8.1",
  "private": true,
  "description": "超级工作台 Android / iOS（Capacitor 外壳，前端与网页版同一份代码）",
  "scripts": {
    "build:web": "cd ../web && VITE_TARGET=app npx vite build",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "sync": "npx cap sync",
    "apk:debug": "npm run build:web && npx cap sync android && node scripts/apply-native.mjs android && cd android && ./gradlew assembleDebug",
    "native": "node scripts/apply-native.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  }
}
