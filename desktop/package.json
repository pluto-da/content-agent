{
  "name": "content-agent-desktop",
  "version": "0.11.0",
  "private": true,
  "description": "超级工作台桌面端（Electron 外壳 + 本机后端）",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "stage": "node ../scripts/stage-desktop.mjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.contentagent.desktop",
    "productName": "超级工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "browser-views.cjs",
      "smoke.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/server",
        "to": "server"
      },
      {
        "from": "stage/web",
        "to": "web"
      },
      {
        "from": "stage/agent",
        "to": "agent"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "artifactName": "content-agent-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "content-agent-${version}-win-${arch}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "content-agent-${version}-mac-${arch}.${ext}"
    },
    "executableName": "content-agent"
  }
}
